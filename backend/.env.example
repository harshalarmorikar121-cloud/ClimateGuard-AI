# Environment
ENVIRONMENT=production
PROJECT_NAME="ClimateGuard AI"

# Database Connection (Default SQLite, or PostgreSQL)
DATABASE_URL=sqlite:///./climateguard.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/climateguard

# JWT Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "https://your-production-domain.com"]

# SMTP Email Notification Settings (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=alerts@climateguard.org
